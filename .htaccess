# DSF website: Apache configuration (shared hosting / cPanel).
# For nginx, see README.md. Safe to delete if the host does not use Apache.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (enable once the SSL certificate is live)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Pick one canonical host (www shown). Enable once the domain is final.
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Keep internal project docs off the public site
  RewriteRule ^docs(/|$) - [F,L]
</IfModule>

# The old Delta Oil domain should 301 to /businesses/delta-oil/ (playbook section 8).
# Configure that on the Delta Oil domain's own host, e.g.:
#   Redirect 301 / https://www.example.com/businesses/delta-oil/

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" (after HTTPS is confirmed)

  <FilesMatch "\.(css|js|woff2|svg|jpg|jpeg|png|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
  AddCharset utf-8 .html .css .js .txt .xml .svg .webmanifest
</IfModule>
